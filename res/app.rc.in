// Generated from res/app.rc.in by CMake — do not edit the generated copy.
//
// Version numbers are single-sourced from MACTAB_VERSION_STRING so that the
// binary's VERSIONINFO, the string the app displays, and the version the
// installer registers in Add/Remove Programs can never drift apart.

#include <windows.h>
#include "resource.h"

// Absolute paths: the generated .rc lives in the build tree, so relative
// references to the source tree would not resolve.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@MACTAB_RES_DIR@/app.manifest"

IDI_APPICON ICON "@MACTAB_RES_DIR@/mactab.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     @MACTAB_VER_MAJOR@,@MACTAB_VER_MINOR@,@MACTAB_VER_PATCH@,0
    PRODUCTVERSION  @MACTAB_VER_MAJOR@,@MACTAB_VER_MINOR@,@MACTAB_VER_PATCH@,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0x0L
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Walid Idrissi Labs"
            VALUE "FileDescription",  "MacTab application switcher"
            VALUE "FileVersion",      "@MACTAB_VERSION_STRING@"
            VALUE "InternalName",     "MacTab"
            VALUE "OriginalFilename", "MacTab.exe"
            VALUE "ProductName",      "MacTab"
            VALUE "ProductVersion",   "@MACTAB_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
