#include <windows.h>
#include "resource.h"

// The manifest is embedded here rather than generated by the linker; see the
// /MANIFEST:NO flag in CMakeLists.txt.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_APPICON ICON "mactab.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     0,1,0,0
    PRODUCTVERSION  0,1,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0x0L
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Walid Idrissi Labs"
            VALUE "FileDescription",  "MacTab application switcher"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "MacTab"
            VALUE "OriginalFilename", "MacTab.exe"
            VALUE "ProductName",      "MacTab"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
